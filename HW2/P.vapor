func List.Insert(this new_elem)
    aux03 = this
    t.1 = HeapAllocZ(16)
    [t.1] = :vmt_List
    aux02 = t.1
    t.2 = [aux02]
    t.2 = [t.2 + 8]
    t.3 =  call t.2(aux02 new_elem aux03 0)
    ret_val = t.3
