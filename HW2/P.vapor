func Element.Equal(this other)
    ret_val = 1
    t.1 = [other]
    t.1 = [t.1 + 8]
    t.2 =  call t.1(other)
    aux01 = t.2
    t.3 = [this+12]
    t.4 = [this]
    t.4 = [t.4 + 20]
    t.5 =  call t.4(this aux01 t.3)
    t.6 = Sub(1 t.6)
    if0 t.5 goto :If1_else
        ret_val = 0
        goto :If1_end
    If1_else:
        t.7 = [other]
        t.7 = [t.7 + 0]
        t.8 =  call t.7(other)
        aux02 = t.8
        t.9 = [this+4]
        t.10 = [this]
        t.10 = [t.10 + 20]
        t.11 =  call t.10(this aux02 t.9)
        t.12 = Sub(1 t.12)
        if0 t.11 goto :If2_else
            ret_val = 0
            goto :If2_end
        If2_else:
            t.13 = [this+8]
            if0 t.13 goto :If3_else
                t.14 = [other]
                t.14 = [t.14 + 16]
                t.15 =  call t.14(other)
                t.16 = Sub(1 t.16)
                if0 t.15 goto :If4_else
                    ret_val = 0
                    goto :If4_end
                If4_else:
                    nt = 0
                If4_end:
                goto :If3_end
            If3_else:
                t.17 = [other]
                t.17 = [t.17 + 16]
                t.18 =  call t.17(other)
                if0 t.18 goto :If5_else
                    ret_val = 0
                    goto :If5_end
                If5_else:
                    nt = 0
                If5_end:
            If3_end:
        If2_end:
    If1_end:
    ret ret_val

func Element.Compare(this num1 num2)
    retval = 0
    t.1 = Add(1 num2)
    aux02 = t.1
    t.2 = LtS(num1 num2)
    if0 t.2 goto :If6_else
        retval = 0
        goto :If6_end
    If6_else:
        t.3 = LtS(num1 aux02)
        t.4 = Sub(1 t.4)
        if0 t.3 goto :If7_else
            retval = 0
            goto :If7_end
        If7_else:
            retval = 1
        If7_end:
    If6_end:
    ret retval

func List.Init(this)
    [this+12] = 1
