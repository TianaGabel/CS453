const vmt_Twenty
    :Twenty.bar
    :Twenty.foo
    :Twenty.increaseResult
    :Twenty.generate

func Main ()
    t.0 = HeapAllocZ(4)
    [t.0] = :vmt_Twenty
    t.1 = [t.0]
    t.1 = [t.1+0]
    t.2 = call t.1(t.0)
    PrintIntS(t.2)
    ret

func Twenty.generate(this)
    t.1 = AddS( 20 10 )
    result = t.1
    ret result

func Twenty.increaseResult(this x)
    t.1 = AddS( x result )
    result = t.1
    ret result

func Twenty.bar(this)
    v = 0
    While1_test:
        if0 10 goto :While1_end
    While1_body:
        While2_test:
            if0 4 goto :While2_end
        While2_body:
            t.1 = AddS( 1 v )
            v = t.1
            goto :While2_test
        While2_end:
        t.2 = AddS( 1 v )
        v = t.2
        goto :While1_test
    While1_end:
    ret v

func Twenty.foo(this)
    if0 20 goto :If3_else
        c = 9
        goto:If3_end
    If3_else:
        c = 1
    If3_end:
    ret c

