const vmt_Twenty
    :Twenty.reset
    :Twenty.increaseResult
    :Twenty.generate

func Main ()
    t.0 = HeapAllocZ(4)
    [t.0] = :vmt_Twenty
    t.1 = [t.0]
    t.1 = [t.1+0]
    t.2 = call t.1(t.0 2)
    PrintIntS(t.2)
    ret

func Twenty.generate(this)
    t.1 = AddS( 20 10 )
    result = t.1
    ret result

func Twenty.increaseResult(this x)
    t.1 = AddS( x result )
    result = t.1
    ret result

func Twenty.reset(this)
    result = 0
    ret result

