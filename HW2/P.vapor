func Tree.Init(this v_key)
    [this+8] = v_key
    [this+20] = 0
    [this+12] = 0
    ret 1

func Tree.SetRight(this rn)
    [this+16] = rn
    ret 1

func Tree.SetLeft(this ln)
    [this+24] = ln
    ret 1

func Tree.GetRight(this)
    ret right

func Tree.GetLeft(this)
    ret left

func Tree.GetKey(this)
    ret key

func Tree.SetKey(this v_key)
    [this+8] = v_key
    ret 1

func Tree.GetHas_Right(this)
    ret has_right

func Tree.GetHas_Left(this)
    ret 0

func Tree.SetHas_Left(this val)
    [this+20] = val
    ret 1

func Tree.SetHas_Right(this val)
    [this+12] = val
    ret 1

func Tree.Compare(this num1 num2)
    ntb = 0
    t.1 = Add(1 num2)
    nti = t.1
    t.2 = LtS(num1 num2)
    if0 t.2 goto :If1_else
        ntb = 0
        goto :If1_end
    If1_else:
        t.3 = LtS(num1 nti)
        t.4 = Sub(1 t.4)
        if0 t.3 goto :If2_else
            ntb = 0
            goto :If2_end
        If2_else:
            ntb = 1
        If2_end:
    If1_end:
    ret ntb

func Tree.Insert(this v_key)
    t.1 = HeapAllocZ(28)
    [t.1] = :vmt_Tree
    new_node = t.1
    t.2 = [new_node]
    t.2 = [t.2 + 28]
    t.3 =  call t.2(new_node v_key)
    ntb = t.3
    current_node = this
    cont = 1
    While3_test:
        if0 cont goto :While3_end
    While3_body:
        t.4 = [current_node]
        t.4 = [t.4 + 60]
        t.5 =  call t.4(current_node)
        key_aux = t.5
        t.6 = LtS(v_key key_aux)
        if0 t.6 goto :If4_else
            t.7 = [current_node]
            t.7 = [t.7 + 36]
            t.8 =  call t.7(current_node)
            if0 t.8 goto :If5_else
                t.9 = [current_node]
                t.9 = [t.9 + 64]
                t.10 =  call t.9(current_node)
                current_node = t.10
                goto :If5_end
            If5_else:
                cont = 0
                t.11 = [current_node]
                t.11 = [t.11 + 4]
                t.12 =  call t.11(current_node 1)
                ntb = t.12
                t.13 = [current_node]
                t.13 = [t.13 + 72]
                t.14 =  call t.13(current_node new_node)
                ntb = t.14
            If5_end:
            goto :If4_end
        If4_else:
            t.15 = [current_node]
            t.15 = [t.15 + 32]
            t.16 =  call t.15(current_node)
            if0 t.16 goto :If6_else
                t.17 = [current_node]
                t.17 = [t.17 + 68]
                t.18 =  call t.17(current_node)
                current_node = t.18
                goto :If6_end
            If6_else:
                cont = 0
                t.19 = [current_node]
                t.19 = [t.19 + 52]
                t.20 =  call t.19(current_node 1)
                ntb = t.20
                t.21 = [current_node]
                t.21 = [t.21 + 12]
                t.22 =  call t.21(current_node new_node)
                ntb = t.22
            If6_end:
        If4_end:
        goto :While3_test
    While3_end:
    ret 1

func Tree.Delete(this v_key)
    current_node = this
    parent_node = this
    cont = 1
    found = 0
    is_root = 1
    While7_test:
        if0 cont goto :While7_end
    While7_body:
        t.1 = [current_node]
        t.1 = [t.1 + 60]
        t.2 =  call t.1(current_node)
        key_aux = t.2
        t.3 = LtS(v_key key_aux)
        if0 t.3 goto :If8_else
            t.4 = [current_node]
            t.4 = [t.4 + 36]
            t.5 =  call t.4(current_node)
            if0 t.5 goto :If9_else
                parent_node = current_node
                t.6 = [current_node]
                t.6 = [t.6 + 64]
                t.7 =  call t.6(current_node)
                current_node = t.7
                goto :If9_end
            If9_else:
                cont = 0
            If9_end:
            goto :If8_end
        If8_else:
            t.8 = LtS(key_aux v_key)
            if0 t.8 goto :If10_else
                t.9 = [current_node]
                t.9 = [t.9 + 32]
                t.10 =  call t.9(current_node)
                if0 t.10 goto :If11_else
                    parent_node = current_node
                    t.11 = [current_node]
                    t.11 = [t.11 + 68]
                    t.12 =  call t.11(current_node)
                    current_node = t.12
                    goto :If11_end
                If11_else:
                    cont = 0
                If11_end:
                goto :If10_end
            If10_else:
                if0 is_root goto :If12_else
                    t.13 = [current_node]
                    t.13 = [t.13 + 32]
                    t.14 =  call t.13(current_node)
                    t.15 = Sub(1 t.15)
                    t.16 = [current_node]
                    t.16 = [t.16 + 36]
                    t.17 =  call t.16(current_node)
                    t.18 = Sub(1 t.18)
                    t.19 = MulS(t.17 t.14)
                    if0 t.19 goto :If13_else
                        ntb = 1
                        goto :If13_end
                    If13_else:
                        t.20 = [this]
                        t.20 = [t.20 + 16]
                        t.21 =  call t.20(this current_node parent_node)
                        ntb = t.21
                    If13_end:
                    goto :If12_end
                If12_else:
                    t.22 = [this]
                    t.22 = [t.22 + 16]
                    t.23 =  call t.22(this current_node parent_node)
                    ntb = t.23
                If12_end:
                found = 1
                cont = 0
            If10_end:
        If8_end:
        is_root = 0
        goto :While7_test
    While7_end:
    ret found

