const vmt_A
    :A.bar
    :A.foo

const vmt_B
    :B.foo
    :A.bar

const vmt_C
    :B.foo
    :A.bar

func Main ()
    t.0 = HeapAllocZ(4)
    [t.0] = :vmt_a
    t.1 = [t.0]
    t.1 = [t.1+0]
    t.2 = call t.1(t.0)
    PrintIntS(t.2)
    ret

func A.foo(this)
    ret 1

func A.bar(this a b)
    d = a
    c = b
    t.1 = MulS(c d)
    ret t.1

func A.foo(this)
    t.1 = heapAllocZ(4)
    [t.1] = :vmt_A
    a = t.1
    PrintInts(MESSAGE SEND)
    result = MESSAGE SEND
    PrintInts(result)
    ret result

func AllocArray(size)
    bytes = MulS(size 4)
    bytes = Add(bytes 4)
    v = HeapAllocZ(bytes)
    [v] = size
    ret v
