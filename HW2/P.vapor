const vmt_BBS
    :BBS.Print
    :BBS.Init
    :BBS.Start
    :BBS.Sort

func Main ()
    t.0 = HeapAllocZ(12)
    [t.0] = :vmt_BBS
    t.1 = [t.0]
    t.1 = [t.1+8]
    t.2 = call t.1(t.0 10)
    PrintIntS(t.2)
    ret

func BBS.Start(this sz)
    t.1 = [this]
    t.1 = [t.1 + 4]
    t.2 =  call t.1(this sz)
    aux01 = t.2
    t.3 = [this]
    t.3 = [t.3 + 0]
    t.4 =  call t.3(this)
    aux01 = t.4
    PrintIntS(99999)
    t.5 = [this]
    t.5 = [t.5 + 12]
    t.6 =  call t.5(this)
    aux01 = t.6
    t.7 = [this]
    t.7 = [t.7 + 0]
    t.8 =  call t.7(this)
    aux01 = t.8
    ret 0

func BBS.Sort(this)
    t.1 = Sub(size 1)
    i = t.1
    t.2 = Sub(0 1)
    aux02 = t.2
    While1_test:
        t.3 = LtS(aux02 i)
        if0 t.3 goto :While1_end
    While1_body:
        j = 1
        While2_test:
            t.4 = Add(1 i)
            t.5 = LtS(j t.4)
            if0 t.5 goto :While2_end
        While2_body:
            t.6 = Sub(j 1)
            aux07 = t.6
            t.7= MulS(aux07 4)
            t.7= Add(t.7 number)
            t.8= [t.7+4]
            aux04 = t.8
            t.9= MulS(j 4)
            t.9= Add(t.9 number)
            t.10= [t.9+4]
            aux05 = t.10
            t.11 = LtS(aux05 aux04)
            if0 t.11 goto :If3_else
                t.12 = Sub(j 1)
                aux06 = t.12
                t.13= MulS(aux06 4)
                t.13= Add(t.13 number)
                t.14= [t.13+4]
                t = t.14
                t.15= MulS(j 4)
                t.15= Add(t.15 number)
                t.16= [t.15+4]
                t.17= MulS(aux06 4)
                t.17= Add(t.17 number)
                [t.17+4] = t.16
                t.18= MulS(j 4)
                t.18= Add(t.18 number)
                [t.18+4] = t
                goto :If3_end
            If3_else:
                nt = 0
            If3_end:
            t.19 = Add(1 j)
            j = t.19
            goto :While2_test
        While2_end:
        t.20 = Sub(i 1)
        i = t.20
        goto :While1_test
    While1_end:
    ret 0

func BBS.Print(this)
    j = 0
    While4_test:
        t.1 = [this+8]
        t.2 = LtS(j t.1)
        if0 t.2 goto :While4_end
    While4_body:
        t.3= MulS(j 4)
        t.3= Add(t.3 number)
        t.4= [t.3+4]
        PrintIntS(t.4)
        t.5 = Add(1 j)
        j = t.5
        goto :While4_test
    While4_end:
    ret 0

func BBS.Init(this sz)
    [this+8] = sz
    t.1 = call :AllocArray(sz)
    [this+4] = t.1
    t.2= MulS(0 4)
    t.2= Add(t.2 number)
    [t.2+4] = 20
    t.3= MulS(1 4)
    t.3= Add(t.3 number)
    [t.3+4] = 7
    t.4= MulS(2 4)
    t.4= Add(t.4 number)
    [t.4+4] = 12
    t.5= MulS(3 4)
    t.5= Add(t.5 number)
    [t.5+4] = 18
    t.6= MulS(4 4)
    t.6= Add(t.6 number)
    [t.6+4] = 2
    t.7= MulS(5 4)
    t.7= Add(t.7 number)
    [t.7+4] = 11
    t.8= MulS(6 4)
    t.8= Add(t.8 number)
    [t.8+4] = 6
    t.9= MulS(7 4)
    t.9= Add(t.9 number)
    [t.9+4] = 9
    t.10= MulS(8 4)
    t.10= Add(t.10 number)
    [t.10+4] = 19
    t.11= MulS(9 4)
    t.11= Add(t.11 number)
    [t.11+4] = 5
    ret 0

func AllocArray(size)
    bytes = MulS(size 4)
    bytes = Add(bytes 4)
    v = HeapAllocZ(bytes)
    [v] = size
    ret v
