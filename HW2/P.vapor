                t.13 = [t.13 + 28]
                t.14 =  call t.13(aux01)
                t.15 = [prev]
                t.15 = [t.15 + 32]
                t.16 =  call t.15(prev t.14)
                aux05 = t.16
                t.17 = Sub(0 555)
                PrintIntS(t.17)
            If10_end:
            goto :If9_end
        If9_else:
            nt = 0
        If9_end:
        t.18 = Sub(1 t.18)
        if0 ret_val goto :If11_else
            prev = aux01
            t.19 = [aux01]
            t.19 = [t.19 + 28]
            t.20 =  call t.19(aux01)
            aux01 = t.20
            t.21 = [aux01]
            t.21 = [t.21 + 4]
            t.22 =  call t.21(aux01)
            var_end = t.22
            t.23 = [aux01]
            t.23 = [t.23 + 24]
            t.24 =  call t.23(aux01)
            var_elem = t.24
            aux04 = 1
            goto :If11_end
        If11_else:
            nt = 0
        If11_end:
        goto :While8_test
    While8_end:
    ret my_head

