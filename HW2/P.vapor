const vmt_Twenty
    :Twenty.reset
    :Twenty.increaseResult
    :Twenty.generate

func Main ()
    t.0 = HeapAllocZ(4)
    [t.0] = :vmt_Twenty
    t.1 = [t.0]
    t.1 = [t.1+0]
    t.2 = call t.1(t.0 2)
    PrintIntS(t.2)
    ret

func Twenty.generate(this)
    t.3 = 20
    t.2 = 10
    result = AddS( t.3 t.2 )
    ret result

func Twenty.generate(this)
    t.3 = 20
    t.2 = 10
    result = t.1
    result = AddS( t.3 t.2 )
    ret t.3

func Twenty.increaseResult(this x)
    result = t.1
    result = AddS( x result )
    ret t.3

func Twenty.reset(this)
    t.1 = 0
    result = t.1
    ret t.1

