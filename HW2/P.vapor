func List.Delete(this e)
    my_head = this
    ret_val = 0
    t.1 = Sub(0 1)
    aux04 = t.1
    aux01 = this
    prev = this
    t.2 = [this+12]
    var_end = t.2
    t.3 = [this+4]
    var_elem = t.3
    While8_test:
        t.4 = Sub(1 t.4)
        t.5 = Sub(1 t.5)
        t.6 = MulS(ret_val var_end)
        if0 t.6 goto :While8_end
    While8_body:
        t.7 = [e]
        t.7 = [t.7 + 12]
        t.8 =  call t.7(e var_elem)
        if0 t.8 goto :If9_else
            ret_val = 1
            t.9 = LtS(aux04 0)
