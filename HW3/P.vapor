    t.20 = [root]
    t.20 = [t.20 + 24]
    t.21 =  call t.20(root)
    ntb = t.21
    PrintIntS(100000000)
    t.22 = HeapAllocZ(12)
    [t.22] = :vmt_MyVisitor
    v = t.22
    PrintIntS(50000000)
    t.23 = [root]
    t.23 = [t.23 + 76]
    t.24 =  call t.23(root v)
    nti = t.24
    PrintIntS(100000000)
    t.25 = [root]
    t.25 = [t.25 + 40]
    t.26 =  call t.25(root 24)
    PrintIntS(t.26)
    t.27 = [root]
    t.27 = [t.27 + 40]
    t.28 =  call t.27(root 12)
    PrintIntS(t.28)
    t.29 = [root]
