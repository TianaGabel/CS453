func TV.Start(this)
    t.1 = HeapAllocZ(28)
    [t.1] = :vmt_Tree
    root = t.1
    t.2 = [root]
    t.2 = [t.2 + 28]
    t.3 =  call t.2(root 16)
    ntb = t.3
    t.4 = [root]
    t.4 = [t.4 + 24]
    t.5 =  call t.4(root)
    ntb = t.5
    PrintIntS(100000000)
    t.6 = [root]
    t.6 = [t.6 + 20]
    t.7 =  call t.6(root 8)
    ntb = t.7
