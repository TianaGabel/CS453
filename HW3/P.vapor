const vmt_Fac
    :Fac.ComputeFac

func Main ()
    t.0 = HeapAllocZ(4)
    [t.0] = :vmt_Fac
    t.1 = [t.0]
    t.1 = [t.1+0]
    t.2 = call t.1(t.0 10)
    PrintIntS(t.2)
    ret

func Fac.ComputeFac(this num)
    t.1 = LtS(num 1)
    if0 t.1 goto :If1_else
        num_aux = 1
        goto :If1_end
    If1_else:
        t.2 = Sub(num 1)
        t.3 = [this]
        t.3 = [t.3 + 0]
        t.4 =  call t.3(this t.2)
        t.5 = MulS(t.4 num)
        num_aux = t.5
    If1_end:
    ret num_aux

func AllocArray(size)
    bytes = MulS(size 4)
    bytes = Add(bytes 4)
    v = HeapAllocZ(bytes)
    [v] = size
    ret v
